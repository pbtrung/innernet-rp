# Maintainer: Trung Pham <trung.pham@zedercorp.com.vn>
#
# Packages prebuilt innernet/innernet-server/rosenpass binaries from a GitHub release of this
# repo (built by bin/build-multiarch.sh + bin/Dockerfile, RELEASE_VERSION=<pkgver>) - this does
# NOT build from source. Update pkgver to match a published `vX.Y.Z` release tag, then run
# `updpkgsums` (from pacman-contrib) to fill in the two source_$CARCH sha256sums below before
# `makepkg`.

pkgname=innernet-rp-bin
pkgver=0.9999
pkgrel=1
pkgdesc="A private network system built on WireGuard, with optional post-quantum key exchange via Rosenpass (prebuilt binaries)"
arch=('x86_64' 'aarch64')
url="https://github.com/pbtrung/innernet-rp"
license=('MIT')
depends=('systemd')
# The official Arch packages list additional runtime deps that do NOT apply to these specific
# binaries, verified against the actual published release asset via `readelf -d`:
#   - innernet/innernet-server (extra/innernet depends on `sqlite`): built for the musl target
#     specifically so rusqlite's "bundled" feature statically links SQLite - readelf shows no
#     NEEDED entries at all (fully static), so there's nothing sqlite-related to depend on.
#   - rosenpass (extra/rosenpass depends on `libsodium findutils gawk wireguard-tools`): this
#     package builds libsodium from source and links it statically (see bin/Dockerfile) -
#     readelf shows only glibc (libc/libm/libgcc_s), no libsodium.so. `findutils`/`gawk` are
#     runtime deps of upstream's separate `rp` wrapper *script*, which this package doesn't ship
#     (only the `rosenpass` binary itself, used via the key_out file mechanism - see
#     doc/design.md 5.6 - not upstream's `wg`-CLI-shelling integration mode), so those don't
#     apply either.
optdepends=('wireguard-tools: wg/wg-quick CLI tools for manual interface inspection')
provides=('innernet' 'innernet-server')
conflicts=('innernet' 'innernet-server')
options=('!strip') # bin/build-multiarch.sh already strips these binaries

_target_x86_64='x86_64-unknown-linux-musl'
_target_aarch64='aarch64-unknown-linux-musl'

source_x86_64=("innernet-rp-${pkgver}-${_target_x86_64}.tar.gz::https://github.com/pbtrung/innernet-rp/releases/download/v${pkgver}/innernet-rp-${pkgver}-${_target_x86_64}.tar.gz")
source_aarch64=("innernet-rp-${pkgver}-${_target_aarch64}.tar.gz::https://github.com/pbtrung/innernet-rp/releases/download/v${pkgver}/innernet-rp-${pkgver}-${_target_aarch64}.tar.gz")

# makepkg only accepts local sources that live alongside the PKGBUILD itself (no `../` path
# traversal - verified: it looks up just the basename in $startdir), so innernet@.service and
# innernet-server@.service here are symlinks to the real files at client/innernet@.service and
# server/innernet-server@.service (the same ones this repo's .deb/.rpm packaging metadata uses) -
# not copies, so there's nothing to keep in sync by hand.
source=(
  'innernet@.service'
  'innernet-server@.service'
)
sha256sums=('943edf174992bb72dd07501903873be40159449935c6ef90a305cad51b359167'
            'f629debbb6539e37ac81a039447b04e66dd3e39c316e414414378e2dbb62eb69')
sha256sums_x86_64=('045a953f7f0d1bf45454cc0bae28d35ca6c9f49699c1104dd444347d2eb86f84')
sha256sums_aarch64=('61f00e14734175f55c4e00ba0e82f62cec92abc057d0953a20dde271c0a89319')

package() {
    install -Dm755 "$srcdir/innernet" "$pkgdir/usr/bin/innernet"
    install -Dm755 "$srcdir/innernet-server" "$pkgdir/usr/bin/innernet-server"
    install -Dm755 "$srcdir/rosenpass" "$pkgdir/usr/bin/rosenpass"

    install -Dm644 "$srcdir/innernet@.service" \
        "$pkgdir/usr/lib/systemd/system/innernet@.service"
    install -Dm644 "$srcdir/innernet-server@.service" \
        "$pkgdir/usr/lib/systemd/system/innernet-server@.service"
}
