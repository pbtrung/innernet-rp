post_install() {
    # Creates the 'rosenpass' system group declared in usr/lib/sysusers.d/innernet-rp.conf
    # immediately, rather than waiting for the next boot's systemd-sysusers.service run - needed
    # right away for --rosenpass-group rosenpass (see README.md's Post-Quantum Key Exchange
    # section) to work without a reboot after installing this package.
    systemd-sysusers usr/lib/sysusers.d/innernet-rp.conf
}

post_upgrade() {
    post_install
}
