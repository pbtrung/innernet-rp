[Unit]
Description=innernet server for %I
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target

[Service]
Type=simple
Environment="RUST_LOG=info"
# Optional per-interface file setting ROSENPASS_ARGS (e.g.
# ROSENPASS_ARGS="--enable-rosenpass --rosenpass-group rosenpass") - see README.md's Post-Quantum
# Key Exchange section and client/innernet@.service's equivalent comment for why this is needed:
# `serve`'s rosenpass flags aren't persisted anywhere, so this service silently runs with
# rosenpass disabled unless they're passed here too. The leading `-` makes a missing file a no-op
# rather than a startup failure; an unset ROSENPASS_ARGS expands to nothing.
EnvironmentFile=-/etc/innernet-server/%i-rosenpass.env
ExecStart=/usr/bin/innernet-server serve %i $ROSENPASS_ARGS
Restart=always
# When the daemon exits, wait this amount of secs before restarting instead of default 100ms.
RestartSec=1

[Install]
WantedBy=multi-user.target
