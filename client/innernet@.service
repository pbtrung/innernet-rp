[Unit]
Description=innernet client daemon for %I
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target
PartOf=innernet.target

[Service]
Type=simple
# Rosenpass is enabled by default here - see README.md's Post-Quantum Key Exchange section.
# `up`'s rosenpass flags aren't persisted anywhere `up` itself reads back, so without this,
# this service's `--daemon` loop would silently run with rosenpass disabled even after an
# earlier one-off `install`/`up --enable-rosenpass`: that invocation's exchange daemon keeps
# running on its own, but nothing would be left polling its log or applying newly-derived
# preshared keys to WireGuard.
#
# To add `--rosenpass-permissive` and/or `--rosenpass-group <name>` (see README.md) without
# editing this unit, set ROSENPASS_EXTRA_ARGS in the optional per-interface file below, e.g.
# ROSENPASS_EXTRA_ARGS="--rosenpass-permissive --rosenpass-group rosenpass". The leading `-`
# makes a missing file a no-op; an unset ROSENPASS_EXTRA_ARGS expands to nothing. To disable
# rosenpass entirely for one interface instead, set ROSENPASS_ARGS="" there (it fully replaces
# the default below, rather than appending).
Environment="ROSENPASS_ARGS=--enable-rosenpass"
EnvironmentFile=-/etc/innernet/%i-rosenpass.env
ExecStart=/usr/bin/innernet up %i --daemon --interval 60 $ROSENPASS_ARGS $ROSENPASS_EXTRA_ARGS
Restart=always
# When the daemon exits, wait this amount of secs before restarting. Used to prevent StartLimitBurst
# (5 by default) restarts happening within StartLimitIntervalSec (10 by default) after which systemd
# would refrain from restarting innernet anymore.
RestartSec=10

[Install]
WantedBy=multi-user.target
