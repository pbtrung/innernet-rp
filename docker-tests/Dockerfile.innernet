####################################################################################################
## WireGuard
####################################################################################################

# Pin go 1.22 as the latest tag of wireguard-go (0.0.20230223) doesn't build with go 1.23+ due to
# its outdated x/net dependency. We can use latest go once they release newer version.
FROM golang:1.22-bookworm as wireguard
ARG wg_go_tag=0.0.20230223

RUN mkdir /repo \
    && curl -L https://github.com/WireGuard/wireguard-go/archive/refs/tags/${wg_go_tag}.tar.gz \
    | tar -xzC /repo --strip-components=1 \
    && cd /repo \
    && CGO_ENABLED=0 make

####################################################################################################
## Final image
####################################################################################################
FROM rust:slim-bookworm
# libsodium-dev/cmake/pkg-config are for building the `rosenpass` binary (its oqs-sys/
# libsodium-sys-stable dependencies) - this is a test image, so a plain dynamic apt libsodium is
# fine here (unlike bin/Dockerfile's release build, which links it statically for portability).
# wireguard-tools provides the `wg` CLI used by run-docker-tests.sh's Rosenpass scenarios to
# inspect preshared keys/endpoints/peer lists - it works against wireguard-go's userspace UAPI
# socket too, not just a real kernel module, so this works regardless of --backend.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsqlite3-dev iproute2 iputils-ping build-essential clang libclang-dev libselinux1-dev cmake pkg-config libsodium-dev wireguard-tools && \
    rm -rf /var/lib/apt/lists/*

# For run-docker-tests.sh's --rosenpass-group scenario (shared::rosenpass's privilege-drop
# support, doc/design.md 6): the group must already exist for --rosenpass-group to work at all -
# this project has no install-time hook to create it, by design (see shared/src/rosenpass.rs
# `resolve_privilege_drop_target`), so it's the deploying image/package's job. `nobody` (the
# fixed unprivileged user the daemon actually runs as) already exists in this base image.
RUN groupadd --system rosenpass

WORKDIR /app

COPY . .
RUN cargo build --features innernet/selinux \
    && strip /app/target/debug/innernet /app/target/debug/innernet-server \
    && cp /app/target/debug/innernet /app/target/debug/innernet-server /usr/bin/ \
    && cargo clean

# Pinned to the same minimum version this project enforces at runtime (MIN_ROSENPASS_VERSION in
# shared/src/rosenpass.rs, CVE-2023-53157 fixed >= 0.2.1).
ARG ROSENPASS_VERSION=0.2.3
RUN cargo install --version "${ROSENPASS_VERSION}" --locked --root /usr/local rosenpass \
    && strip /usr/local/bin/rosenpass \
    && rm -rf /usr/local/cargo/registry

COPY ./docker-tests/start-client.sh ./
COPY ./docker-tests/start-server.sh ./
COPY --from=wireguard /repo/wireguard-go /usr/bin/

CMD ["/app/start-server.sh"]
